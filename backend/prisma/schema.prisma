generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Sport {
  CRICKET
  KABADDI
  FOOTBALL
  BADMINTON
  VOLLEYBALL
  BASKETBALL
  TENNIS
  OTHER
}

enum SurfaceType {
  TURF
  CONCRETE
  CLAY
  SYNTHETIC
  GRASS
}

enum GroundType {
  OPEN
  TURF
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE
  TEAM_INVITE
  TEAM_ROLE_ASSIGNED
}

enum TeamRole {
  ADMIN
  CAPTAIN
  VICE_CAPTAIN
  WICKET_KEEPER
  PLAYER
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  phone       String  @unique
  fullName    String
  username    String  @unique
  bio         String?

  dateOfBirth DateTime
  gender      Gender
  profilePhotoUrl String?

  country     String
  state       String
  city        String
  area        String?
  pincode     String
  latitude    Float?
  longitude   Float?

  passwordHash    String?
  email           String? @unique
  googleId        String? @unique
  isVerified      Boolean @default(false)
  fcmToken        String?

  isGroundOwner   Boolean @default(false)

  isActive        Boolean   @default(true)
  lastActiveAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sports        UserSport[]
  ownedGrounds  Ground[]       @relation("GroundOwner")
  slotBookings  GroundSlot[]   @relation("SlotBooker")
  sentMessages     Message[]   @relation("MessageSender")
  receivedMessages Message[]   @relation("MessageReceiver")
  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionReceiver")
  notifications       Notification[] @relation("NotificationUser")
  notificationsFrom   Notification[] @relation("NotificationFrom")
  createdTeams        Team[]         @relation("TeamCreator")
  teamMemberships     TeamMember[]
  createdMatches      Match[]        @relation("MatchCreator")
  matchPlayerData     MatchPlayer[]  @relation("MatchPlayerUser")

  @@index([username])
  @@index([phone])
  @@index([city])
  @@map("users")
}

// ─────────────────────────────────────────────
// USER SPORT
// ─────────────────────────────────────────────

model UserSport {
  id     String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  sport         Sport
  skillLevel    SkillLevel?
  preferredRole String?

  matchesPlayed Int @default(0)
  matchesWon    Int @default(0)
  rating        Float @default(0)

  stats Json?

  joinedAt  DateTime @default(now())

  @@unique([userId, sport])
  @@index([userId])
  @@index([sport])
  @@map("user_sports")
}

// ─────────────────────────────────────────────
// GROUND
// ─────────────────────────────────────────────

model Ground {
  id String @id @default(cuid())

  owner   User   @relation("GroundOwner", fields: [ownerId], references: [id])
  ownerId String

  name        String
  description String?

  addressLine String
  city        String
  state       String
  pincode     String

  latitude    Float
  longitude   Float

  supportedSports Sport[]
  amenities       String[]
  surfaceType     SurfaceType?
  isIndoor        Boolean @default(false)
  groundType      GroundType @default(TURF)

  // Daily operating hours — "HH:MM" 24-hour, applies every day
  openTime  String @default("06:00")
  closeTime String @default("22:00")

  capacity Json?

  pricePerHour Float
  currency     String @default("INR")

  photos String[]

  rules               String?
  cancellationPolicy  String?
  contactPhone        String

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots GroundSlot[]

  @@index([ownerId])
  @@index([city])
  @@index([pincode])
  @@index([isActive, isVerified])
  @@map("grounds")
}

// ─────────────────────────────────────────────
// GROUND SLOT
// ─────────────────────────────────────────────

model GroundSlot {
  id String @id @default(cuid())

  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)
  groundId String

  sport     Sport
  slotDate  DateTime
  startTime DateTime
  endTime   DateTime

  priceOverride Float?

  status SlotStatus @default(AVAILABLE)

  bookedBy   User?   @relation("SlotBooker", fields: [bookedById], references: [id])
  bookedById String?
  bookingId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groundId, slotDate, status])
  @@index([groundId, sport])
  @@index([status])
  @@map("ground_slots")
}

// ─────────────────────────────────────────────
// MESSAGE
// ─────────────────────────────────────────────

model Message {
  id         String        @id @default(cuid())

  from       User          @relation("MessageSender",   fields: [fromId], references: [id], onDelete: Cascade)
  fromId     String

  to         User          @relation("MessageReceiver", fields: [toId],   references: [id], onDelete: Cascade)
  toId       String

  content    String
  read       Boolean       @default(false)
  status     MessageStatus @default(SENT)

  deletedForSender   Boolean @default(false)
  deletedForReceiver Boolean @default(false)
  deletedForEveryone Boolean @default(false)

  forwardedFromId    String?
  forwardedFrom      Message?  @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards           Message[] @relation("MessageForwards")

  createdAt  DateTime @default(now())

  @@index([fromId, toId])
  @@index([toId, fromId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// CONNECTION (friend requests)
// ─────────────────────────────────────────────

model Connection {
  id          String           @id @default(cuid())
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
  @@map("connections")
}

// ─────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  user       User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  fromUser   User?            @relation("NotificationFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromUserId String?
  type       NotificationType
  data       Json?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// TEAM
// ─────────────────────────────────────────────

model Team {
  id          String       @id @default(cuid())
  name        String
  sport       String       @default("CRICKET")
  description String?
  logoUrl     String?
  inviteCode  String       @unique
  maxPlayers  Int          @default(11)
  createdBy      String
  creator        User         @relation("TeamCreator", fields: [createdBy], references: [id])
  members        TeamMember[]
  matchesAsTeam1 Match[]      @relation("MatchTeam1")
  matchesAsTeam2 Match[]      @relation("MatchTeam2")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([inviteCode])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(PLAYER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// ─────────────────────────────────────────────
// MATCH
// ─────────────────────────────────────────────

enum MatchStatus {
  IN_PROGRESS
  INNINGS_BREAK
  COMPLETED
}

enum TossChoice {
  BAT
  BOWL
}

model Match {
  id                  String      @id @default(cuid())

  team1Id             String
  team1               Team        @relation("MatchTeam1", fields: [team1Id], references: [id])
  team2Id             String
  team2               Team        @relation("MatchTeam2", fields: [team2Id], references: [id])

  totalOvers          Int
  matchFormat         String      @default("CUSTOM")
  ballType            String      @default("LEATHER")
  powerplayOvers      Int         @default(6)
  isTest              Boolean     @default(false)

  tossWonByTeamId     String
  tossChoice          TossChoice
  battingFirstTeamId  String

  status              MatchStatus @default(IN_PROGRESS)
  currentInning       Int         @default(1)

  strikerBatsmanId    String?
  nonStrikerBatsmanId String?
  currentBowlerId     String?

  createdBy           String
  creator             User        @relation("MatchCreator", fields: [createdBy], references: [id])

  innings             MatchInning[]
  players             MatchPlayer[]

  result              String?
  winnerTeamId        String?
  bestBatsmanId       String?
  bestBowlerId        String?
  mvpId               String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([createdBy])
  @@index([status])
  @@index([team1Id])
  @@index([team2Id])
  @@map("matches")
}

model MatchInning {
  id            String   @id @default(cuid())

  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  inningNumber  Int
  battingTeamId String
  bowlingTeamId String

  totalRuns     Int      @default(0)
  totalWickets  Int      @default(0)
  legalBalls    Int      @default(0)
  extras        Int      @default(0)
  completed     Boolean  @default(false)

  balls         MatchBall[]

  createdAt     DateTime @default(now())

  @@index([matchId])
  @@map("match_innings")
}

model MatchBall {
  id          String      @id @default(cuid())

  inningId    String
  inning      MatchInning @relation(fields: [inningId], references: [id], onDelete: Cascade)

  overNumber  Int
  ballNumber  Int
  batsmanId   String
  bowlerId    String

  runs        Int         @default(0)
  extras      Int         @default(0)
  extraType   String?

  isWicket    Boolean     @default(false)
  wicketType  String?
  caughtById  String?

  prevStrikerBatsmanId    String?
  prevNonStrikerBatsmanId String?

  createdAt   DateTime    @default(now())

  @@index([inningId])
  @@map("match_balls")
}

model MatchPlayer {
  id               String   @id @default(cuid())

  matchId          String
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("MatchPlayerUser", fields: [userId], references: [id])
  teamId           String

  runsScored       Int      @default(0)
  ballsFaced       Int      @default(0)
  fours            Int      @default(0)
  sixes            Int      @default(0)
  isOut            Boolean  @default(false)

  runsConceded     Int      @default(0)
  legalBallsBowled Int      @default(0)
  wicketsTaken     Int      @default(0)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@map("match_players")
}
